#!/bin/sh
# Service controller invoked by DSM Package Center.
#
# DSM's generated pkgctl-nomad.service (Type=oneshot, RemainAfterExit=yes) runs
# `synopkgctl start nomad`, which calls this script's `start`. We launch Nomad
# in the background with a PID file and return promptly; the RemainAfterExit
# wrapper keeps the backgrounded daemon alive. Nomad runs as the package user
# unless privileged mode has made its binary setuid-root (see the README and
# share/enable-privileges.sh).

PKG_ROOT="/var/packages/nomad"
VAR="${PKG_ROOT}/var"
PIDFILE="${VAR}/run/nomad.pid"
LOG="${VAR}/logs/nomad.log"
RUN="${PKG_ROOT}/target/share/run-nomad.sh"

pid_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "${1:-}" in
    start)
        if pid_running; then
            exit 0
        fi
        mkdir -p "${VAR}/run" "${VAR}/logs"
        # run-nomad.sh waits for the advertise interface then exec's Nomad, so
        # the recorded PID becomes Nomad's own.
        "$RUN" &
        echo $! > "$PIDFILE"
        exit 0
        ;;
    stop)
        if pid_running; then
            pid="$(cat "$PIDFILE")"
            kill -INT "$pid" 2>/dev/null
            i=0
            while [ "$i" -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
                i=$((i + 1))
                sleep 1
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "$pid" 2>/dev/null
            fi
        fi
        # Catch a Nomad whose PID we somehow lost track of.
        pkill -INT -x nomad 2>/dev/null || true
        rm -f "$PIDFILE"
        exit 0
        ;;
    status)
        if pid_running; then
            exit 0
        fi
        rm -f "$PIDFILE"
        exit 3
        ;;
    log)
        echo "$LOG"
        ;;
    *)
        exit 1
        ;;
esac
exit 0
